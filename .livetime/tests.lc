Connect with delay and spawn points (2 players)
	open https://up4playing.com/{id}/{time}x0
	delay 5000
	click window:0 x:-410 y:-420
	delay 500
	assert window:0 lobby.points[0].x == -410
	assert window:0 lobby.points[0].y == -420
	
	open https://up4playing.com/{id}/{time}x1
	delay 5000
	click window:1 x:430 y:-440
	delay 500
	assert window:1 lobby.points[0].x == -410
	assert window:1 lobby.points[0].y == -420
	assert window:0 lobby.points[1].x ==  430
	assert window:0 lobby.points[1].y == -440
	
	save if:error value:core.logs to:logs/{time}-{window}.txt
	repeat
	
Connect Test
	open windows:4 https://up4playing.com/{id}/{time}
	assert delay:15000 input.players.length == 4
	repeat
	
Reconnect Test
	open https://up4playing.com/{id}/{time}x0
	open https://up4playing.com/{id}/{time}x1
	open https://up4playing.com/{id}/{time}x2
	open https://up4playing.com/{id}/{time}x3
	assert delay:10000 input.players.length == 4
	
	load window:3 https://up4playing.com/{id}/{time}u3
	assert window:3 delay:5000 core.errorMessage.length == 0
	save value:core.logs to:logs/{time}-{window}.txt
	goto 5

